{
  "name": "codictator-root",
  "version": "0.0.0",
  "private": true,
  "packageManager": "npm@11.19.1",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome ci .",
    "test": "node --test packages/codictator/tests packages/vscode/tests",
    "ledger": "node -e \"console.error('red-ledger runner lands in step 1.6');process.exit(2)\"",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-lines=90 --test-coverage-branches=80 packages/codictator/tests packages/vscode/tests",
    "test:stress": "node --test tests/stress/",
    "build": "tsc -b packages/codictator packages/vscode",
    "test:extension": "node -e \"console.error('extension-host runner lands with packages/vscode');process.exit(2)\"",
    "test:packaging": "npm run build && npm pack --dry-run -w codictator"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "24.19.2",
    "@types/vscode": "1.105.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.0.0",
    "ovsx": "1.3.0",
    "typescript": "7.0.2"
  }
}
