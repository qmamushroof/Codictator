{
	"name": "codictator-root",
	"version": "0.0.0",
	"private": true,
	"packageManager": "npm@11.19.1",
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"typecheck": "tsc --noEmit -p packages/codictator && tsc --noEmit -p packages/vscode",
		"lint": "biome ci .",
		"test": "node packages/codictator/tests/support/red-ledger-runner.ts",
		"ledger": "node packages/codictator/tests/support/red-ledger-runner.ts --ledger",
		"test:coverage": "node --test --experimental-test-coverage --test-coverage-lines=90 --test-coverage-branches=80 --test-coverage-exclude=\"**/tests/support/**\" \"packages/codictator/tests/**/*.test.ts\" \"packages/vscode/tests/**/*.test.ts\"",
		"test:stress": "node --test tests/stress/",
		"build": "tsc -b packages/codictator packages/vscode",
		"test:extension": "node -e \"console.error('extension-host runner lands with packages/vscode');process.exit(2)\"",
		"test:packaging": "npm run build && npm pack --dry-run -w codictator"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@types/node": "24.19.2",
		"@types/vscode": "1.105.0",
		"@vscode/test-electron": "3.1.0",
		"@vscode/vsce": "4.0.0",
		"ovsx": "1.3.0",
		"typescript": "7.0.2"
	}
}
