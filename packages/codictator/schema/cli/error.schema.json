{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://codictator.dev/schema/cli/error.schema.json",
	"title": "CLI error envelope",
	"description": "SPEC §4.19.1: --json rendering of a CdxError (exit per SPEC §8.1).",
	"type": "object",
	"properties": {
		"code": { "type": "string", "pattern": "^CDX-E[0-9]{3}$" },
		"message": { "type": "string", "minLength": 1 },
		"remediation": { "type": "string", "minLength": 1 },
		"detail": { "type": "string" }
	},
	"required": ["code", "message", "remediation"],
	"additionalProperties": false
}
