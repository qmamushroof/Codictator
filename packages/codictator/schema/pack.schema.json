{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"title": "Codictator pack.json (SPEC §7.3)",
	"type": "object",
	"required": [
		"id",
		"version",
		"description",
		"rules",
		"enforcers",
		"maxWaiverDays"
	],
	"additionalProperties": false,
	"properties": {
		"id": { "type": "string", "minLength": 1 },
		"version": { "type": "string", "minLength": 1 },
		"description": { "type": "string", "minLength": 1 },
		"rules": {
			"type": "array",
			"items": {
				"type": "object",
				"required": [
					"id",
					"family",
					"tier",
					"statement",
					"reason",
					"remediation",
					"enforcer",
					"triggers",
					"scope",
					"params",
					"measureVersion",
					"fixtures"
				],
				"additionalProperties": false,
				"properties": {
					"id": { "type": "string", "minLength": 1 },
					"family": { "type": "string", "minLength": 1 },
					"tier": { "type": "string", "minLength": 1 },
					"statement": { "type": "string", "minLength": 1 },
					"reason": { "type": "string", "minLength": 1 },
					"remediation": { "type": "string", "minLength": 1 },
					"enforcer": { "type": "string", "minLength": 1 },
					"triggers": { "type": "array", "items": { "type": "string" } },
					"scope": { "type": "array", "items": { "type": "string" } },
					"params": { "type": "object" },
					"ratchet": {},
					"measureVersion": { "type": "integer", "minimum": 1 },
					"fixtures": {
						"type": "object",
						"required": ["violating", "passing"],
						"additionalProperties": false,
						"properties": {
							"violating": { "type": "array", "items": { "type": "string" } },
							"passing": { "type": "array", "items": { "type": "string" } }
						}
					}
				}
			}
		},
		"enforcers": { "type": "array", "items": { "type": "object" } },
		"drivers": { "type": "array", "items": { "type": "object" } },
		"extractors": { "type": "array", "items": { "type": "object" } },
		"measures": { "type": "array", "items": { "type": "object" } },
		"capabilities": { "type": "array", "items": { "type": "object" } },
		"assets": { "type": "array", "items": { "type": "object" } },
		"maxWaiverDays": { "type": "integer", "minimum": 1 }
	}
}
