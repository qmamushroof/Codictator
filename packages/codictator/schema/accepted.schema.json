{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"title": "Codictator accepted.json (SPEC §7.4)",
	"type": "object",
	"required": [
		"version",
		"packHash",
		"selfTestHash",
		"acceptedAt",
		"acceptedBy"
	],
	"additionalProperties": false,
	"properties": {
		"version": { "const": 1 },
		"packHash": { "type": "string", "minLength": 1 },
		"selfTestHash": { "type": "string", "minLength": 1 },
		"acceptedAt": { "type": "string", "minLength": 1 },
		"acceptedBy": { "type": "string", "minLength": 1 }
	}
}
