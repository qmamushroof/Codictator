{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"title": "Codictator pack draft (SPEC §4.16.3)",
	"description": "LLM draft for the generator flow: rules expressed only as template ids and parameters, plus fixtures. The generator validates the draft against this shape, runs one repair round, then materialises it.",
	"type": "object",
	"required": ["packId", "description", "rules"],
	"additionalProperties": false,
	"properties": {
		"packId": { "type": "string", "minLength": 1 },
		"description": { "type": "string", "minLength": 1 },
		"rules": {
			"type": "array",
			"minItems": 1,
			"items": {
				"type": "object",
				"required": [
					"id",
					"template",
					"params",
					"statement",
					"reason",
					"remediation",
					"tier",
					"violatingFixture",
					"passingFixture"
				],
				"additionalProperties": false,
				"properties": {
					"id": { "type": "string", "minLength": 1 },
					"template": { "type": "string", "minLength": 1 },
					"params": { "type": "object" },
					"statement": { "type": "string", "minLength": 1 },
					"reason": { "type": "string", "minLength": 1 },
					"remediation": { "type": "string", "minLength": 1 },
					"tier": { "type": "string", "enum": ["floor", "tunable"] },
					"violatingFixture": { "type": "string", "minLength": 1 },
					"passingFixture": { "type": "string", "minLength": 1 }
				}
			}
		}
	}
}
