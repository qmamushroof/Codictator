{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"title": "Codictator waivers.json (SPEC §7.5)",
	"type": "object",
	"required": ["version", "waivers"],
	"additionalProperties": false,
	"properties": {
		"version": { "const": 1 },
		"waivers": {
			"type": "array",
			"items": {
				"type": "object",
				"required": ["id", "rule", "reason", "created", "expires", "createdBy"],
				"additionalProperties": false,
				"properties": {
					"id": { "type": "string", "pattern": "^W-[0-9]{4}$" },
					"rule": { "type": "string", "minLength": 1 },
					"params": { "type": "object" },
					"paths": { "type": "array", "items": { "type": "string" } },
					"reason": { "type": "string", "minLength": 1 },
					"created": { "type": "string", "minLength": 1 },
					"expires": { "type": "string", "minLength": 1 },
					"createdBy": { "type": "string", "minLength": 1 },
					"renews": { "type": "string", "minLength": 1 }
				}
			}
		}
	}
}
