{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"title": "Codictator guardrail manifest (SPEC §7.14)",
	"type": "object",
	"required": ["version", "codictator", "artifacts", "hash"],
	"additionalProperties": false,
	"properties": {
		"version": { "const": 1 },
		"codictator": { "type": "string", "minLength": 1 },
		"artifacts": {
			"type": "array",
			"items": {
				"type": "object",
				"required": ["path", "owner", "mode", "hash"],
				"additionalProperties": false,
				"properties": {
					"path": { "type": "string", "minLength": 1 },
					"owner": { "type": "string", "minLength": 1 },
					"mode": { "enum": ["file", "block", "entries"] },
					"hash": { "type": "string", "minLength": 1 }
				}
			}
		},
		"hash": { "type": "string", "minLength": 1 }
	}
}
