{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"title": "Codictator config.json (SPEC §7.2)",
	"type": "object",
	"required": ["version", "codictator", "packs", "harnesses"],
	"additionalProperties": false,
	"properties": {
		"version": { "const": 1 },
		"codictator": { "type": "string", "minLength": 1 },
		"packs": {
			"type": "array",
			"items": {
				"type": "object",
				"required": ["id"],
				"additionalProperties": false,
				"properties": {
					"id": { "type": "string", "minLength": 1 },
					"version": { "type": "string", "minLength": 1 },
					"path": { "type": "string", "minLength": 1 }
				}
			}
		},
		"harnesses": {
			"type": "array",
			"minItems": 1,
			"items": { "type": "string", "minLength": 1 }
		},
		"tunables": { "type": "object" },
		"architecture": { "type": "object" },
		"workflow": { "type": "object" },
		"spec": { "type": "object" },
		"testing": { "type": "object" },
		"commands": { "type": "object" },
		"steering": { "type": "object" },
		"tools": { "type": "array", "items": { "type": "object" } },
		"security": { "type": "object" },
		"deps": { "type": "object" },
		"network": { "type": "object" },
		"integrity": { "type": "object" },
		"ci": { "type": "object" },
		"llm": { "type": "object" }
	}
}
