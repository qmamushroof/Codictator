{
	"name": "codictator-vscode",
	"publisher": "codictator",
	"version": "0.0.0",
	"type": "module",
	"main": "dist/extension.cjs",
	"engines": {
		"vscode": "^1.105.0"
	},
	"activationEvents": [
		"workspaceContains:.codictator/config.json",
		"onView:Codictator"
	],
	"capabilities": {
		"untrustedWorkspaces": {
			"supported": false
		}
	},
	"contributes": {
		"viewsContainers": {
			"activitybar": [
				{
					"id": "Codictator",
					"title": "Codictator",
					"icon": "resources/codictator.svg"
				}
			]
		},
		"views": {
			"Codictator": [
				{
					"id": "codictator-active-rules",
					"name": "Active rules"
				},
				{
					"id": "codictator-violations",
					"name": "Violations"
				},
				{
					"id": "codictator-timeline",
					"name": "Timeline"
				}
			]
		}
	}
}
