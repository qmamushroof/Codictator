{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"overrides": [
		{
			"includes": [
				".codictator/bin/**",
				".codictator/*.json",
				".codictator/tasks/*.json",
				".codictator/reviews/*.json"
			],
			"formatter": { "enabled": false },
			"linter": { "enabled": false }
		},
		{
			"includes": ["packages/vscode/resources/**"],
			"formatter": { "enabled": false },
			"linter": { "enabled": false }
		}
	],
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"suspicious": {
				"noExplicitAny": "error"
			},
			"style": {
				"noDefaultExport": "error",
				"noNonNullAssertion": "error",
				"useFilenamingConvention": {
					"level": "error",
					"options": {
						"filenameCases": ["kebab-case"]
					}
				}
			}
		}
	}
}
